# Public repository allowlist. Raw experiments and local configuration stay local.
/*
!/.gitignore
!/README.md
!/Makefile
!/src/
!/archive/
!/baselines/
!/docs/
!/config/
!/scripts/
!/tests/
!/training/
!/.github/
/config/*
!/config/example.json
/tests/*
!/tests/test_engine.cpp
!/tests/test_search_v2.cpp
!/tests/test_search_v3.cpp
!/tests/test_search_v3_tt.cpp
!/tests/test_vct_v5.cpp
!/tests/test_export_games.py
!/tests/test_stateful_probe.py
!/tests/match.py
!/tests/fixtures/
/tests/fixtures/*
!/tests/fixtures/stateful_positions.json
/training/*
!/training/README.md
!/training/README_stateful_probe.md
!/training/probe_stateful.cpp
!/training/arena.py
!/training/arena_fixed_openings.py
!/training/search_base.cpp
!/training/search_v3_base.cpp
!/training/search_v4_base.cpp
!/training/search_v5_base.cpp
!/training/search_v6_base.cpp
!/training/train_policy.py
!/training/train_scaled_policy.py
!/training/train_direct_rl.py
!/training/export_cpp.py
!/training/label_teacher.py
!/training/build_teacher.sh
!/training/book_generate.py
!/training/book_export.py
!/training/book_build_candidate.py
!/training/book_validate.py
!/training/book_probe.cpp
**/__pycache__/
**/.DS_Store
**/*.pyc
**/*.pt
**/*.pth
**/*.pem
**/*.key
**/.env*
**/~$*
